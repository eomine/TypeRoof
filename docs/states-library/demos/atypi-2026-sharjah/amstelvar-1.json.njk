{%- macro color(rgb, alpha) -%}
{
                "instance": {
                  "R": "{{ rgb[0] }}",
                  "G": "{{ rgb[1] }}",
                  "B": "{{ rgb[2] }}"{% if alpha %},
                  "alpha": "{{ alpha }}"{% endif %}
                },
                "colorTypeKey": "RGB"
              }
{%- endmacro %}
{%- macro pairs(items) -%}
{%- if items | length == 1 -%}
[["{{ items[0][0] }}", "{{ items[0][1] }}"]]
{%- else -%}
[
{%- for item in items %}
                ["{{ item[0] }}", "{{ item[1] }}"]{{ "," if not loop.last }}
{%- endfor %}
              ]
{%- endif -%}
{%- endmacro %}
{%- macro axesOf(location) -%}
{%- set items = [] %}
{%- for axis, value in location %}{% set _ = items.push([axis, value]) %}{% endfor %}
{{- pairs(items) -}}
{%- endmacro %}
{%- macro label(name, text, y) %}
      {
        "instance": {
          "label": "{{ name }}",
          "keyMoments": [
            {
              "label": "Key Moment 1",
              "duration": "1",
              "easing": "linear",
              "isActive": "1",
              "numericProperties": {{ pairs([["y", y], ["x", 618], ["width", 100]]) }},
              "textColor": {{ color(labelColor, "0.00000") }},
              "textRun": "{{ text }}",
              "textAlign": "center"
            }
          ]
        },
        "actorTypeKey": "LineOfTextActorModel"
      }
{%- endmacro %}
{%- macro axesRow(row, fadeOut = false) %}
{#- locations[i] is the location after changes[i - 1]; a list, because
    a {% set %} inside a for loop does not outlive its iteration -#}
{%- set locations = [row.start.axes] %}
{%- for change in row.changes %}
  {%- set _ = locations.push(locations | last | merge(change.axes)) %}
{%- endfor %}
      {
        "instance": {
          "label": "{{ row.label }}",
          "keyMoments": [
            {
              "label": "wait",
              "duration": "{{ row.waitDuration }}",
              "easing": "linear",
              "numericProperties": {{ pairs([["x", row.x], ["y", row.y], ["width", textWidth]]) }},
              "axesLocations": {{ axesOf(row.waitAxes) }},
              "fontSize": "40",
              "textColor": {{ color(white, "0.00000") }},
              "textRun": "{{ sample }}",
              "textAlign": "center"
            },
            {
              "label": "start",
              "duration": "{{ row.start.duration }}",
              "easing": "linear",
              "numericProperties": {{ pairs([["y", row.y], ["width", textWidth]]) }},
              "axesLocations": {{ axesOf(row.start.axes) }},
              "textColor": {{ color(white, "0.00000") }}
            },
            {
              "label": "fade in",
              "duration": "{{ row.fadeIn }}",
              "easing": "linear",
              "axesLocations": {{ axesOf(row.start.axes) }},
              "textColor": {{ color(white, "100.00000") }}
            },
{%- for change in row.changes %}
            {
              "label": "{{ change.label }}",
              "duration": "{{ change.duration }}",
              "easing": "linear",
              "axesLocations": {{ axesOf(locations[loop.index]) }}
            },
            {
              "label": "pause",
              "duration": "{{ change.pause }}",
              "easing": "linear",
              {%- if change.isActive %}
              "isActive": "1",{% endif %}
              "axesLocations": {{ axesOf(locations[loop.index]) }},
              "textColor": {{ color(white, "100.00000") }}
            }{{ "," if (not loop.last) or fadeOut }} 
{%- endfor %}
{%- if fadeOut -%}
            {
              "label": "fade out",
              "duration": "{{ row.fadeIn }}",
              "easing": "linear",
              "axesLocations": {{ axesOf(locations | last) }},
              "textColor": {{ color(white, "0.00000") }}
            },
            {
              "label": "stay",
              "duration": "157",
              "easing": "linear",
              "axesLocations": {{ axesOf(locations | last) }},
              "textColor": {{ color(white, "0.00000") }}
            }
{%- endif %}
          ]
        },
        "actorTypeKey": "LineOfTextActorModel"
      }
{%- endmacro -%}
