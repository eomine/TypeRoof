---json
{
  "permalink": "{{ page.filePathStem }}",
  "layout": null
}
---
{#-
  Three rows of "HODnop01" at opsz 144, 14 and 8. The opsz 144 and 8
  rows are built from the parametric axes and step through them one at
  a time, see text144 and text8 below.
-#}
{%- set sample = "HODnop01" %}
{%- set stageWidth = 1336 %}
{%- set labelColor = [0, 128, 255] %}
{%- set white = [255, 255, 255] %}
{#-
  Rows that step through the parametric axes, one settings block each.
  label, y      actor label and vertical position
  waitDuration  time before the row starts changing, at waitAxes
  start         duration and full axes location the animation starts from;
                its key order is the order the axes are written in
  fadeIn        duration of the fade in, at the start location
  changes       applied one after the other; every change is kept, so each
                location builds on the previous one
    label, duration, axes   the moment that animates to the changed axes
    pause                   duration of the "pause" moment that holds them
    isActive                marks that pause as the active key moment
-#}
{%- set text8 = {
  "label": "text 8",
  "y": 550,
  "waitDuration": 1,
  "waitAxes": {"opsz": "14"},
  "start": {"duration": 5, "axes": {
    "XTSP": "0", "XOPQ": "90", "YOPQ": "66", "XTRA": "400",
    "XSHA": "104", "YSHA": "50", "XSVA": "55", "YSVA": "165", "YTLC": "511"
  } },
  "fadeIn": 3,
  "changes": [
    {"label": "XOPQ", "duration": 2, "axes": {"XOPQ": "112"}, "pause": 1},
    {"label": "YOPQ", "duration": 2, "axes": {"YOPQ": "91"}, "pause": 1},
    {"label": "XTRA", "duration": 2, "axes": {"XTRA": "400"}, "pause": 1},
    {"label": "YTLC", "duration": 2, "axes": {"YTLC": "536"}, "pause": 1},
    {"label": "Serifs", "duration": 2, "axes": {"XSHA": "104", "YSHA": "75", "XSVA": "80", "YSVA": "149"}, "pause": 1, "isActive": true},
    {"label": "XTSP", "duration": 2, "axes": {"XTSP": "10"}, "pause": 28}
  ]
} %}
{#- a copy of text 8 to start from: adjust its axes values and timings -#}
{%- set text144 = {
  "label": "text 144",
  "y": 150,
  "waitDuration": 1,
  "waitAxes": {"opsz": "14"},
  "start": {"duration": 25, "axes": {
    "XTSP": "0", "XOPQ": "90", "YOPQ": "66", "XTRA": "400",
    "XSHA": "104", "YSHA": "50", "XSVA": "55", "YSVA": "165", "YTLC": "511"
  } },
  "fadeIn": 3,
  "changes": [
    {"label": "XOPQ", "duration": 2, "axes": {"XOPQ": "84"}, "pause": 1},
    {"label": "YOPQ", "duration": 2, "axes": {"YOPQ": "16"}, "pause": 1},
    {"label": "XTRA", "duration": 2, "axes": {"XTRA": "348"}, "pause": 1},
    {"label": "YTLC", "duration": 2, "axes": {"YTLC": "471"}, "pause": 1},
    {"label": "Serifs", "duration": 2, "axes": {"XSHA": "82", "YSHA": "12", "XSVA": "14", "YSVA": "153"}, "pause": 1, "isActive": true},
    {"label": "XTSP", "duration": 2, "axes": {"XTSP": "10"}, "pause": 3}
  ]
} %}
{%- macro color(rgb, alpha) -%}
{
                "instance": {
                  "R": "{{ rgb[0] }}",
                  "G": "{{ rgb[1] }}",
                  "B": "{{ rgb[2] }}"{% if alpha %},
                  "alpha": "{{ alpha }}"{% endif %}
                },
                "colorTypeKey": "RGB"
              }
{%- endmacro %}
{%- macro pairs(items) -%}
{%- if items | length == 1 -%}
[["{{ items[0][0] }}", "{{ items[0][1] }}"]]
{%- else -%}
[
{%- for item in items %}
                ["{{ item[0] }}", "{{ item[1] }}"]{{ "," if not loop.last }}
{%- endfor %}
              ]
{%- endif -%}
{%- endmacro %}
{%- macro axesOf(location) -%}
{%- set items = [] %}
{%- for axis, value in location %}{% set _ = items.push([axis, value]) %}{% endfor %}
{{- pairs(items) -}}
{%- endmacro %}
{%- macro label(name, text, y) %}
      {
        "instance": {
          "label": "{{ name }}",
          "keyMoments": [
            {
              "label": "Key Moment 1",
              "duration": "1",
              "easing": "linear",
              "isActive": "1",
              "numericProperties": {{ pairs([["y", y], ["x", 618], ["width", 100]]) }},
              "textColor": {{ color(labelColor, "0.00000") }},
              "textRun": "{{ text }}",
              "textAlign": "center"
            }
          ]
        },
        "actorTypeKey": "LineOfTextActorModel"
      }
{%- endmacro %}
{%- macro axesRow(row) %}
{#- locations[i] is the location after changes[i - 1]; a list, because
    a {% set %} inside a for loop does not outlive its iteration -#}
{%- set locations = [row.start.axes] %}
{%- for change in row.changes %}
  {%- set _ = locations.push(locations | last | merge(change.axes)) %}
{%- endfor %}
      {
        "instance": {
          "label": "{{ row.label }}",
          "keyMoments": [
            {
              "label": "wait",
              "duration": "{{ row.waitDuration }}",
              "easing": "linear",
              "numericProperties": {{ pairs([["y", row.y], ["width", stageWidth]]) }},
              "axesLocations": {{ axesOf(row.waitAxes) }},
              "fontSize": "66",
              "textColor": {{ color(white, "0.00000") }},
              "textRun": "{{ sample }}",
              "textAlign": "center"
            },
            {
              "label": "start",
              "duration": "{{ row.start.duration }}",
              "easing": "linear",
              "numericProperties": {{ pairs([["y", row.y], ["width", stageWidth]]) }},
              "axesLocations": {{ axesOf(row.start.axes) }},
              "textColor": {{ color(white, "0.00000") }}
            },
            {
              "label": "fade in",
              "duration": "{{ row.fadeIn }}",
              "easing": "linear",
              "axesLocations": {{ axesOf(row.start.axes) }},
              "textColor": {{ color(white, "100.00000") }}
            },
{%- for change in row.changes %}
            {
              "label": "{{ change.label }}",
              "duration": "{{ change.duration }}",
              "easing": "linear",
              "axesLocations": {{ axesOf(locations[loop.index]) }}
            },
            {
              "label": "pause",
              "duration": "{{ change.pause }}",
              "easing": "linear",
              {%- if change.isActive %}
              "isActive": "1",{% endif %}
              "axesLocations": {{ axesOf(locations[loop.index]) }}
            }{{ "," if not loop.last }}
{%- endfor %}
          ]
        },
        "actorTypeKey": "LineOfTextActorModel"
      }
{%- endmacro -%}
{
