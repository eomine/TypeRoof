{#-
  One "H" that steps through the blend sources of Amstelvar, one
  parametric axis at a time, and returns to the default between each
  source. The source values come from blends.json.
-#}
{%- set sample = "H" %}
{%- set stageWidth = 1336 %}
{%- set textWidth = 1000 %}
{%- set position = [["x", (stageWidth - textWidth) / 2], ["y", 100], ["width", textWidth]] %}
{%- set white = [255, 255, 255] %}
{%- set black = [0, 0, 0] %}
{%- set defaultAxes = {"opsz": "14", "XOUC": "90", "XSHU": "104", "XTUC": "400", "XUCS": "145", "YOUC": "66", "YSHU": "50", "YTUC": "750"} %}
{%- set defaultInstance = {
  "label": "default",
  "changes": [
    {"label": "all", "axes": defaultAxes }
  ]
} %}
{#-
  The blend sources, in the order they are shown. defaultInstance is
  shown before the first, between each and after the last. Each change
  is a moment that animates to its axes, followed by a "pause" that
  holds them; the changes build on the previous location.
-#}
