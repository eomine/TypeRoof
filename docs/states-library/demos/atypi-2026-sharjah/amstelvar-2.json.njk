              "axesLocations": {{ axesOf(defaultAxes) }},
              "textColor": {{ color(white, "100.00000") }}
            },
{%- for instance in instances %}
            {{ instanceKeyMoments(defaultInstance) }}
            {{ instanceKeyMoments(instance) }}
{%- endfor %}
            {{ instanceKeyMoments(defaultInstance) }}
            {
              "label": "fade out",
              "duration": "3",
              "easing": "easeOutQuad",
              "textColor": {{ color(white, "100.00000") }}
            },
            {
              "label": "end",
              "duration": "3",
              "easing": "easeOutQuad",
              "textColor": {{ color(white, "0.00000") }}
            }
          ]
        },
