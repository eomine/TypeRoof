{%- macro color(rgb, alpha) -%}
{
                "instance": {
                  "R": "{{ rgb[0] }}",
                  "G": "{{ rgb[1] }}",
                  "B": "{{ rgb[2] }}"{% if alpha is defined %},
                  "alpha": "{{ alpha }}"{% endif %}
                },
                "colorTypeKey": "RGB"
              }
{%- endmacro %}
{%- macro pairs(items) -%}
              [
{%- for item in items %}
                ["{{ item[0] }}", "{{ item[1] }}"]{{ "," if not loop.last }}
{%- endfor %}
              ]
{%- endmacro %}
{%- macro axesOf(location) -%}
{%- set items = [] %}
{%- for axis, value in location %}{% set _ = items.push([axis, value]) %}{% endfor %}
{{- pairs(items) -}}
{%- endmacro %}
{%- macro instanceKeyMoments(instance) %}
{%- set locations = [] %}
{%- for change in instance.changes %}
  {%- set _ = locations.push(defaultAxes | merge(locations | last | merge(change.axes))) %}
{%- endfor %}
{%- for change in instance.changes %}
            {
              "label": "{{ instance.label }} {{ change.label }}",
              "duration": "3",
              "easing": "easeOutQuad",
              "axesLocations": {{ axesOf(locations[loop.index0]) }}
            },
            {
              "label": "pause",
              "duration": "3",
              "easing": "easeOutQuad",
              "axesLocations": {{ axesOf(locations[loop.index0]) }}
            },
{%- endfor %}
{%- endmacro %}
{
  "activeState": {
    "t": "0",
